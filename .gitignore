# 临时索引、备份、测试输出和可重建工程
/tmp/
# 仅供本地查阅的第三方手册与竞赛指南
/docs/reference/

# Vivado 自动生成的缓存、综合/实现结果和临时工程数据
vivado/**/.*.cache/
vivado/**/*.cache/
vivado/**/*.gen/
vivado/**/*.runs/
vivado/**/*.hw/
vivado/**/*.sim/
vivado/**/ip_user_files/
vivado/**/.Xil/
vivado/**/bd/**/ui/
**/.Xil/
**/xsim.dir/
**/*.ip_user_files/

# Vitis/Codex 等 IDE 的本机工作区和日志，不是项目源代码
_ide/
.rigel_lopper/
.metadata/
*.vitisWorkspace.json
**/__pycache__/
*.pyc
**/.venv/
**/node_modules/
# Python检查工具缓存和本机目录元数据；正式UI源码与图片不忽略。
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
.DS_Store
Thumbs.db
Desktop.ini

# 工具日志、波形、报告和中间网表
*.jou
*.log
*.str
*.wdb
*.vcd
*.dcp
*.pb
*.rpt
*.rpx
*.wdf
*.xpe
*.backup.*

# 编译、下载派生产物默认忽略；下方仅精确放行latest交付文件。
*.bit
*.bin
*.ltx
*.mcs
*.prm
*.pdi
*.elf
*.hwh
*.hwdef
*.xsa


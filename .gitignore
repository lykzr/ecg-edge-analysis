*.bit
*.bin
*.ltx
*.mcs
*.prm
*.pdi
*.elf
*.hwh
*.hwdef
*.xsa

# 旧脚本和通用构建目录
build/
export/
logs/
*.o
*.d
*.lock

# 本地凭证，示例配置保留
.env
.env.*
!.env.example
myself.md

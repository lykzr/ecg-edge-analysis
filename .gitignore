# 临时索引、备份、测试输出和可重建工程
/tmp/
# 仅供本地查阅的第三方手册与竞赛指南
/docs/reference/

# Vivado 自动生成的缓存、综合/实现结果和临时工程数据
vivado/**/.*.cache/
vivado/**/*.cache/
vivado/**/*.gen/
vivado/**/*.runs/
vivado/**/*.hw/
vivado/**/*.sim/
vivado/**/ip_user_files/
vivado/**/.Xil/
vivado/**/bd/**/ui/
**/.Xil/
**/xsim.dir/
**/*.ip_user_files/

# Vitis/Codex 等 IDE 的本机工作区和日志，不是项目源代码
_ide/
.rigel_lopper/
.metadata/
*.vitisWorkspace.json
**/__pycache__/
*.pyc
**/.venv/
**/node_modules/

# 工具日志、波形、报告和中间网表
*.jou
*.log
*.str
*.wdb
*.vcd
*.dcp
*.pb
*.rpt
*.rpx
*.wdf
*.xpe
*.backup.*

# 编译、下载和硬件交付生成物；需要发布时放到 GitHub Release
*.bit
*.bin
*.ltx
*.mcs
*.prm
*.pdi
*.elf
*.hwh
*.hwdef
*.xsa

# 子工程的编译目录；根 build/ 保存正式 Tcl 脚本
**/build/
!/build/
/build/*
!/build/*.tcl
!/build/README.md
export/
logs/
*.o
*.d
*.lock

# 本地凭证，示例配置保留
.env
.env.*
!.env.example
myself.md
/lykzr.md

# 正式过程记录与精选验收日志随仓库；其他原始日志保留本地，默认忽略。
!/docs/records/lykzr.md
!/docs/records/smoke_board_20261017/uart_smoke_pass.log
!/docs/records/smoke_board_20261017/jtag_smoke_pass.log
!/docs/records/smoke_release_checks_20261017.log
!/docs/records/qrs_recheck_development_20261016.log
!/docs/records/qrs_recheck_evaluation_20261016.log
!/docs/records/cnn_cv_verification_20261017.log

# 发布目录仅保留 latest 的明确交付文件；历史版本留在本地，不删除
/releases/*
!/releases/README.md
!/releases/latest/
/releases/latest/*
!/releases/latest/README.md
!/releases/latest/artifacts.json
!/releases/latest/manifest.json
!/releases/latest/expected_uart.txt
!/releases/latest/LICENSE
!/releases/latest/third_party.md
!/releases/latest/hardware/
/releases/latest/hardware/*
!/releases/latest/hardware/ecg_system_candidate.bit
!/releases/latest/hardware/ecg_system_candidate.xsa
!/releases/latest/hardware/ps7_init.tcl
!/releases/latest/prebuilt/
/releases/latest/prebuilt/*
!/releases/latest/prebuilt/ecg_smoke.elf
!/releases/latest/board/
/releases/latest/board/*
!/releases/latest/board/build_ecg_smoke.py
!/releases/latest/board/capture_uart.ps1
!/releases/latest/board/create_workspace.py
!/releases/latest/board/create_workspace.ps1
!/releases/latest/board/run_smoke.ps1
!/releases/latest/board/run_smoke.tcl
!/releases/latest/board/launch_template.json
!/releases/latest/src/
/releases/latest/src/*
!/releases/latest/src/ps/
/releases/latest/src/ps/*
!/releases/latest/src/ps/ecg_smoke/
/releases/latest/src/ps/ecg_smoke/*
!/releases/latest/src/ps/ecg_smoke/main.c

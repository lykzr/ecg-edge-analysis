# 临时索引、备份、测试输出和可重建工程
/tmp/
# 仅供本地查阅的第三方手册与竞赛指南
/docs/reference/

# Vivado 自动生成的缓存、综合/实现结果和临时工程数据
vivado/**/.*.cache/
vivado/**/*.cache/
vivado/**/*.gen/
vivado/**/*.runs/
vivado/**/*.hw/
vivado/**/*.sim/
vivado/**/ip_user_files/
vivado/**/.Xil/
vivado/**/bd/**/ui/
**/.Xil/
**/xsim.dir/
**/*.ip_user_files/

# Vitis/Codex 等 IDE 的本机工作区和日志，不是项目源代码
_ide/
.metadata/
*.vitisWorkspace.json
**/__pycache__/
*.pyc
**/.venv/
**/node_modules/

# 工具日志、波形、报告和中间网表
*.jou
*.log
*.str
*.wdb
*.vcd
*.dcp
*.pb
*.rpt
*.rpx
*.wdf
*.xpe
*.backup.*


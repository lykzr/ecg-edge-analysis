# 默认使用仓库内HGB研究模型；none显式关闭，openecg仍为可选项。
ECG_MODEL_TYPE=hgb
# 网页与模型环境可分离；为空时使用网页当前Python。不在启动时安装依赖。
# ECG_HGB_PYTHON=<具备模型依赖的Python可执行文件>
# 外部解释仅从进程环境读取；本轮保持本地模板。
ECG_EXPLANATION_PROVIDER=template
# 配置变化后重启服务。数据目录默认位于项目tmp/web_runtime。
# HEALTH_DB_PATH=
# ECG_UPLOAD_DIR=
# ECG_WEB_LIVE_DIR=
# ECG_TASK_WORKERS=1
# ECG_SIGNAL_SOURCE=auto
# ECG_AUDIT_RETENTION_DAYS=90
